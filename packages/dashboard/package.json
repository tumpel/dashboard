{
  "name": "@tumpel/dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "The built tumpel web dashboard: static assets to serve behind a server that inserts the tumpel-api-origin meta tag",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tumpel/dashboard.git",
    "directory": "packages/dashboard"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "storybook": "storybook dev --host 0.0.0.0 --port 6006 --no-open",
    "build-storybook": "storybook build --output-dir dist-storybook",
    "test": "node --conditions=tumpel-source --test --test-timeout=30000 test/*.test.ts"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@storybook/react-vite": "^10.6.7",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-table": "^8.21.3",
    "@tumpel/api": "https://github.com/tumpel/protocol/releases/download/v0.2.0/tumpel-api-0.2.0.tgz",
    "@tumpel/openapi": "https://github.com/tumpel/protocol/releases/download/v0.2.0/tumpel-openapi-0.2.0.tgz",
    "@tumpel/pages": "*",
    "@tumpel/schemas": "https://github.com/tumpel/protocol/releases/download/v0.2.0/tumpel-schemas-0.2.0.tgz",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.73.0",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "storybook": "^10.6.7",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "zod": "^4.6.7"
  }
}
