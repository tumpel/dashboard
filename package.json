{
  "name": "tumpel-dashboard",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/pages",
    "packages/dashboard"
  ],
  "scripts": {
    "lint": "biome check .",
    "fix": "biome check --write .",
    "build": "npm run build --workspaces --if-present",
    "build-storybook": "npm run build-storybook -w @tumpel/dashboard",
    "screenshots:mobile": "npx playwright install --only-shell chromium && npm run build-storybook && node npm-scripts/mobile-screenshots.mjs",
    "screenshots:mobile:check": "npx playwright install --with-deps --only-shell chromium && node npm-scripts/mobile-screenshots.mjs --check",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "comments:check": "node npm-scripts/comments-check.mjs",
    "secrets:check": "node npm-scripts/secrets-check.mjs",
    "prose:check": "node npm-scripts/prose-check.mjs",
    "check": "npm run lint && npm run comments:check && npm run secrets:check && npm run prose:check && npm run typecheck",
    "test": "node --test --test-timeout=120000 npm-scripts/*.test.mjs && npm test --workspaces --if-present",
    "pack": "npm run build && node npm-scripts/pack.mjs",
    "pack:check": "node npm-scripts/pack-check.mjs",
    "release:prepare": "node npm-scripts/release.mjs prepare",
    "release:publish": "node npm-scripts/release.mjs publish",
    "release:dispatch": "node npm-scripts/release.mjs dispatch"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.0",
    "playwright": "^1.65.1",
    "typescript": "^5.9.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
